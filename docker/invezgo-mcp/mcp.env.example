# Salin -> mcp.env (gitignored), lalu isi. JANGAN commit nilai asli.
# INVEZGO_API_KEY: samakan dgn /root/IDX_Trecker_Wahyu/.env
# MCP_AUTH_TOKEN : generate acak kuat, mis:  openssl rand -base64 32
INVEZGO_API_KEY=
MCP_AUTH_TOKEN=

# Opsional: 1 = expose tool personal read-only (portfolio/journal/trade/
# watchlist akun Invezgo). Default 0 — kalau token MCP bocor, data pribadi
# tetap tak ter-expose. Ubah lalu `docker compose ... up -d` utk reload.
MCP_ENABLE_PERSONAL=0
